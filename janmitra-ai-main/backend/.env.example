# JanMitra AI - Backend Environment Variables Configuration

# Project Mode
PROJECT_NAME="JanMitra AI Backend"

# Database Connection (Supabase PostgreSQL URL)
# Replace with your actual Supabase PostgreSQL connection string
DATABASE_URL="sqlite:///./janmitra.db"

# Supabase Auth & Storage Configurations
SUPABASE_URL=""
SUPABASE_KEY=""

# AI & LLM Inference Settings
# Paste your Groq API Key here to use Groq's cloud-based model inference (e.g. Llama-3.3-70b)
GROQ_API_KEY=""

# Local Ollama URL (fallback if Groq is not used)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma2:9b"
